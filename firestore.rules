rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isHostAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email == 'kishanaddagalla@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNotBlocked(userId) {
      return !exists(/databases/$(database)/documents/blockedUsers/$(userId));
    }

    function hasValidUserParent(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function hasValidRollParent(userId, rollId) {
      return exists(/databases/$(database)/documents/users/$(userId)/rolls/$(rollId)) &&
        get(/databases/$(database)/documents/users/$(userId)/rolls/$(rollId)).data.ownerId == request.auth.uid;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'presetCount', 'rollCount', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid == userId && data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() <= 200 &&
        (!('presetCount' in data) || (data.presetCount is int && data.presetCount >= 0 && data.presetCount <= 1000)) &&
        (!('rollCount' in data) || (data.rollCount is int && data.rollCount >= 0 && data.rollCount <= 1000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGradingPreset(data, userId, presetId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'settings', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'name', 'settings', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) && data.id == presetId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerId == userId && data.ownerId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.settings is map && data.settings.keys().size() <= 30 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFilmRoll(data, userId, rollId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'rollTitle', 'camera', 'lens', 'filmStock',
          'iso', 'notes', 'activeFrameId', 'frameCount', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'rollTitle', 'camera', 'lens', 'filmStock',
          'iso', 'notes', 'activeFrameId', 'frameCount', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) && data.id == rollId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerId == userId && data.ownerId == request.auth.uid &&
        data.rollTitle is string && data.rollTitle.size() >= 1 && data.rollTitle.size() <= 120 &&
        data.camera is string && data.camera.size() <= 100 &&
        data.lens is string && data.lens.size() <= 100 &&
        data.filmStock is string && data.filmStock.size() <= 100 &&
        data.iso is string && data.iso.size() <= 24 &&
        data.notes is string && data.notes.size() <= 1000 &&
        (data.activeFrameId == null || (data.activeFrameId is string && data.activeFrameId.size() <= 128)) &&
        data.frameCount is int && data.frameCount >= 0 && data.frameCount <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFilmFrame(data, userId, rollId, frameId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'rollId', 'order', 'name', 'filmStockLabel', 'notes',
          'isSample', 'sampleId', 'width', 'height', 'detectedType',
          'settings', 'syncImageDataUrl', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'rollId', 'order', 'name', 'filmStockLabel', 'notes',
          'isSample', 'sampleId', 'width', 'height', 'detectedType',
          'settings', 'syncImageDataUrl', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) && data.id == frameId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerId == userId && data.ownerId == request.auth.uid &&
        isValidId(data.rollId) && data.rollId == rollId &&
        data.order is int && data.order >= 0 && data.order <= 500 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.filmStockLabel is string && data.filmStockLabel.size() <= 120 &&
        data.notes is string && data.notes.size() <= 600 &&
        data.isSample is bool &&
        (data.sampleId == null || (data.sampleId is string && data.sampleId.size() <= 128)) &&
        data.width is int && data.width >= 1 && data.width <= 20000 &&
        data.height is int && data.height >= 1 && data.height <= 20000 &&
        data.detectedType in ['c41', 'bw', 'positive'] &&
        data.settings is map && data.settings.keys().size() <= 30 &&
        data.syncImageDataUrl is string && data.syncImageDataUrl.size() <= 750000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSiteConfig(data, configId) {
      return data.keys().hasAll([
          'id', 'announcementEnabled', 'announcementText', 'maintenanceMode',
          'maintenanceMessage', 'cloudSyncEnabled', 'cameraScannerEnabled',
          'updatedBy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'announcementEnabled', 'announcementText', 'maintenanceMode',
          'maintenanceMessage', 'cloudSyncEnabled', 'cameraScannerEnabled',
          'creatorName', 'updatedBy', 'updatedAt'
        ]) &&
        data.id is string && data.id == 'global' && data.id == configId &&
        data.announcementEnabled is bool &&
        data.announcementText is string && data.announcementText.size() <= 280 &&
        data.maintenanceMode is bool &&
        data.maintenanceMessage is string && data.maintenanceMessage.size() <= 280 &&
        data.cloudSyncEnabled is bool &&
        data.cameraScannerEnabled is bool &&
        (!('creatorName' in data) || (data.creatorName is string && data.creatorName.size() <= 80)) &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        data.updatedBy == request.auth.uid &&
        data.updatedAt is timestamp;
    }

    function isValidFeaturedPreset(data, presetId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'description', 'isPublic',
          'settings', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'name', 'description', 'isPublic',
          'settings', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) && data.id == presetId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.description is string && data.description.size() <= 160 &&
        data.isPublic is bool && data.isPublic == true &&
        data.settings is map && data.settings.keys().size() <= 30 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFeedbackReport(data, feedbackId) {
      return data.keys().hasAll([
          'id', 'authorUid', 'authorName', 'authorEmail',
          'category', 'message', 'status', 'hostNote', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'authorUid', 'authorName', 'authorEmail',
          'category', 'message', 'status', 'hostNote', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) && data.id == feedbackId &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.authorName is string && data.authorName.size() <= 120 &&
        data.authorEmail is string && data.authorEmail.size() <= 200 &&
        data.category in ['feature', 'bug', 'film-stock', 'general'] &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
        data.status in ['open', 'resolved'] &&
        data.hostNote is string && data.hostNote.size() <= 400 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBlockedMember(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'reason', 'blockedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'reason', 'blockedBy', 'createdAt']) &&
        isValidId(data.uid) && data.uid == userId &&
        data.email is string && data.email.size() <= 200 &&
        data.reason is string && data.reason.size() <= 200 &&
        data.blockedBy is string && data.blockedBy.size() >= 1 && data.blockedBy.size() <= 128 &&
        data.blockedBy == request.auth.uid &&
        data.createdAt is timestamp;
    }

    match /siteConfig/{configId} {
      allow get: if configId == 'global';
      allow list: if false;
      allow create: if isValidId(configId) && configId == 'global' &&
        isHostAdmin() &&
        isValidSiteConfig(incoming(), configId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(configId) && configId == 'global' &&
        isHostAdmin() &&
        isValidSiteConfig(incoming(), configId) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'announcementEnabled', 'announcementText', 'maintenanceMode',
          'maintenanceMessage', 'cloudSyncEnabled', 'cameraScannerEnabled',
          'creatorName', 'updatedBy', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /featuredPresets/{presetId} {
      allow get: if isValidId(presetId) && (existing().isPublic == true || isHostAdmin());
      allow list: if resource.data.isPublic == true;
      allow create: if isValidId(presetId) && isHostAdmin() &&
        isValidFeaturedPreset(incoming(), presetId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(presetId) && isHostAdmin() &&
        isValidFeaturedPreset(incoming(), presetId) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'description', 'isPublic', 'settings', 'updatedAt'
        ]);
      allow delete: if isValidId(presetId) && isHostAdmin();
    }

    match /feedback/{feedbackId} {
      allow get: if isValidId(feedbackId) &&
        (isHostAdmin() || (isSignedIn() && existing().authorUid == request.auth.uid));
      allow list: if isHostAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isValidId(feedbackId) && isVerifiedUser() &&
        isValidFeedbackReport(incoming(), feedbackId) &&
        incoming().authorUid == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().hostNote == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(feedbackId) && isHostAdmin() &&
        isValidFeedbackReport(incoming(), feedbackId) &&
        incoming().id == existing().id &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'hostNote', 'updatedAt']);
      allow delete: if isValidId(feedbackId) &&
        (isHostAdmin() || (isVerifiedUser() && existing().authorUid == request.auth.uid));
    }

    match /blockedUsers/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isHostAdmin());
      allow list: if isHostAdmin();
      allow create: if isValidId(userId) && isHostAdmin() &&
        userId != request.auth.uid &&
        isValidBlockedMember(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(userId) && isHostAdmin() &&
        userId != request.auth.uid &&
        isValidBlockedMember(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'reason', 'blockedBy']);
      allow delete: if isValidId(userId) && isHostAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isHostAdmin());
      allow list: if isHostAdmin();
      allow create: if isValidId(userId) && isVerifiedUser() && isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isVerifiedUser() && isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'presetCount', 'rollCount', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isVerifiedUser() && isOwner(userId);

      match /presets/{presetId} {
        allow get: if isValidId(userId) && isValidId(presetId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(presetId) && isVerifiedUser() &&
          isOwner(userId) &&
          isNotBlocked(userId) &&
          isValidGradingPreset(incoming(), userId, presetId) &&
          hasValidUserParent(userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(presetId) && isVerifiedUser() &&
          isOwner(userId) &&
          isNotBlocked(userId) &&
          isValidGradingPreset(incoming(), userId, presetId) &&
          hasValidUserParent(userId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'settings', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(presetId) && isVerifiedUser() && isOwner(userId);
      }

      match /rolls/{rollId} {
        allow get: if isValidId(userId) && isValidId(rollId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(rollId) && isVerifiedUser() &&
          isOwner(userId) &&
          isNotBlocked(userId) &&
          isValidFilmRoll(incoming(), userId, rollId) &&
          hasValidUserParent(userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(rollId) && isVerifiedUser() &&
          isOwner(userId) &&
          isNotBlocked(userId) &&
          isValidFilmRoll(incoming(), userId, rollId) &&
          hasValidUserParent(userId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'rollTitle', 'camera', 'lens', 'filmStock', 'iso',
            'notes', 'activeFrameId', 'frameCount', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(rollId) && isVerifiedUser() && isOwner(userId);

        match /frames/{frameId} {
          allow get: if isValidId(userId) && isValidId(rollId) && isValidId(frameId) && isOwner(userId);
          allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(userId) && isValidId(rollId) && isValidId(frameId) &&
            isVerifiedUser() && isOwner(userId) &&
            isNotBlocked(userId) &&
            isValidFilmFrame(incoming(), userId, rollId, frameId) &&
            hasValidRollParent(userId, rollId) &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time;
          allow update: if isValidId(userId) && isValidId(rollId) && isValidId(frameId) &&
            isVerifiedUser() && isOwner(userId) &&
            isNotBlocked(userId) &&
            isValidFilmFrame(incoming(), userId, rollId, frameId) &&
            hasValidRollParent(userId, rollId) &&
            incoming().id == existing().id &&
            incoming().ownerId == existing().ownerId &&
            incoming().rollId == existing().rollId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'order', 'name', 'filmStockLabel', 'notes',
              'settings', 'syncImageDataUrl', 'updatedAt'
            ]);
          allow delete: if isValidId(userId) && isValidId(rollId) && isValidId(frameId) &&
            isVerifiedUser() && isOwner(userId);
        }
      }
    }
  }
}
